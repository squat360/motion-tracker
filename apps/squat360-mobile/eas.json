{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "20.19.4"
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_ENV": "preview",
        "EXPO_NO_MEDIAPIPE": "1"
      },
      "node": "20.19.4"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "node": "20.19.4"
    },
    "pose": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "node": "20.19.4",
      "env": {
        "APP_ENV": "pose",
        "EXPO_NO_MEDIAPIPE": "0"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
