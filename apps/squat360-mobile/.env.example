# Optional Firebase (stubs only until wired)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

# ComfyUI GPU box for avatar renders (empty = skip queue)
EXPO_PUBLIC_COMFYUI_URL=

# Optional OpenAI-compatible chat. Empty URL = Super Coach stays fully on-device.
# Cloud copy may rewrite briefing/answer text only — never phase, load, or calories.
EXPO_PUBLIC_LLM_URL=
EXPO_PUBLIC_LLM_API_KEY=
EXPO_PUBLIC_LLM_MODEL=gpt-4o-mini
